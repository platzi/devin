# Hay dos perfiles y cada script de npm elige el suyo:
#   npm run dev       -> .env.local (Supabase local; `npm run supabase:start` imprime los valores)
#   npm run dev:prod  -> .env.prod  (proyecto shiplog en la nube)
# Lo mismo aplica a `npm run build` y `npm run build:prod`.
# Copia este archivo a .env.local y a .env.prod con los valores de cada entorno.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
